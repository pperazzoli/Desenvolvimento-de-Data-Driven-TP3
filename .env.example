# Copie este arquivo para .env e escolha UMA das opções abaixo.

# Opção 1 (recomendada): Google Gemini, camada gratuita.
# Crie a chave em https://aistudio.google.com/apikey
MODELO_LLM=google_genai:gemini-3.5-flash-lite
GOOGLE_API_KEY=
# Modelo de reserva, usado quando o principal falha (ex.: "503 - high demand"). Opcional.
MODELO_RESERVA=google_genai:gemini-3.6-flash

# Opção 2: modelo local com Ollama (gratuito e offline, exige GPU para ficar rápido).
# Instale o Ollama, rode "ollama pull qwen3:8b" e descomente a linha abaixo.
# MODELO_LLM=ollama:qwen3:8b
